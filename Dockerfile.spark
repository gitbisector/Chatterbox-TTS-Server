FROM nvidia/cuda:13.2.0-runtime-ubuntu24.04

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/hf_cache
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev python3-venv \
    build-essential libsndfile1 ffmpeg git \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt ./

# Install PyTorch with CUDA from the nightly index (aarch64 + CUDA 13.x)
ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN pip3 install --no-cache-dir \
    torch torchaudio --index-url https://download.pytorch.org/whl/nightly/cu130 && \
    grep -vi '^torch' requirements.txt | \
    pip3 install --no-cache-dir -r /dev/stdin && \
    pip3 install --no-cache-dir --no-deps \
    git+https://github.com/devnen/chatterbox-v2.git@master s3tokenizer==0.3.0 onnx==1.16.0 && \
    pip3 install --no-cache-dir "protobuf>=4.25.0"

COPY . .
COPY bf16_patch.py /tmp/bf16_patch.py
RUN mkdir -p model_cache reference_audio outputs voices logs hf_cache && \
    python3 /tmp/bf16_patch.py

EXPOSE 8004
CMD ["python3", "server.py"]
