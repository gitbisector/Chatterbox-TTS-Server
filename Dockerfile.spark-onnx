# Chatterbox Multilingual ONNX — DGX Spark (GB10, aarch64, CUDA 13)
#
# Multi-stage build:
#   Stage 1: Build onnxruntime v1.24.4 from source with CUDA EP (sm_121)
#   Stage 2: Lightweight runtime image with ONNX Runtime GPU
#
# Build:
#   docker build -f Dockerfile.spark-onnx -t chatterbox-onnx:latest .
#
# The ORT build takes ~30-60 min. To cache the wheel for faster rebuilds:
#   docker build --target ort-builder -f Dockerfile.spark-onnx -t ort-builder:latest .
#   docker cp $(docker create ort-builder:latest):/ort/build/Linux/Release/dist/ ./ort-wheels/
# Then uncomment the COPY line in Stage 2 and comment out the --from=ort-builder line.

# ============================================================
# Stage 1: Build onnxruntime with CUDA EP for aarch64 + sm_121
# ============================================================
FROM nvidia/cuda:13.2.0-devel-ubuntu24.04 AS ort-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev python3-venv \
    cmake git curl \
    libcudnn9-cuda-13 libcudnn9-dev-cuda-13 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Build onnxruntime from source
# Per: https://forums.developer.nvidia.com/t/onnx-runtime-gpu-inference-on-dgx-spark-gx10-build-guide-and-prebuilt-binaries/366157
RUN git clone --recursive --branch v1.24.4 --depth 1 \
    https://github.com/microsoft/onnxruntime.git /ort

WORKDIR /ort

ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN pip3 install --no-cache-dir numpy packaging wheel setuptools

RUN ./build.sh --config Release \
    --use_cuda --cuda_home /usr/local/cuda \
    --cudnn_home /usr \
    --build_shared_lib --build_wheel \
    --parallel $(nproc) \
    --skip_tests \
    --allow_running_as_root \
    --cmake_extra_defines CMAKE_CUDA_ARCHITECTURES=121

# ============================================================
# Stage 2: Runtime image
# ============================================================
FROM nvidia/cuda:13.2.0-runtime-ubuntu24.04

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/hf_cache
ENV DEBIAN_FRONTEND=noninteractive
ENV CHATTERBOX_ENGINE=onnx

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev \
    libsndfile1 ffmpeg \
    libcudnn9-cuda-13 \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install the custom-built onnxruntime wheel
COPY --from=ort-builder /ort/build/Linux/Release/dist/*.whl /tmp/
# Alternatively, if you pre-cached the wheel:
# COPY ort-wheels/*.whl /tmp/

ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN pip3 install --no-cache-dir /tmp/*.whl && rm -f /tmp/*.whl

# Install PyTorch CPU-only (needed by config.py, utils.py, and engine API tensor wrapping)
RUN pip3 install --no-cache-dir \
    torch torchaudio --index-url https://download.pytorch.org/whl/cpu \
    || pip3 install --no-cache-dir torch torchaudio

# Install remaining Python dependencies
RUN pip3 install --no-cache-dir \
    fastapi==0.115.12 \
    uvicorn==0.34.3 \
    pydantic==2.11.4 \
    PyYAML==6.0.2 \
    numpy \
    librosa==0.11.0 \
    soundfile==0.13.1 \
    pydub \
    transformers==4.46.3 \
    huggingface_hub \
    resemble-perth==1.0.1 \
    tqdm \
    jinja2 \
    python-multipart

WORKDIR /app
COPY config.py config.yaml models.py server.py utils.py engine_onnx.py ./
COPY services/chatterbox-onnx-export/alignment_runtime.py services/chatterbox-onnx-export/
COPY ui ui/
COPY voices voices/
# onnx-models/ is mounted at runtime — files are owned by root from the docker-based
# export and are too large to bake into the image.

RUN mkdir -p model_cache reference_audio outputs voices logs hf_cache

EXPOSE 8004
CMD ["python3", "server.py"]
